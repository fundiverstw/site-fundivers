# Response headers for the deployed site. Cloudflare reads this file out of the
# uploaded assets; it is not part of the site itself.
#
# Everything under /assets/ is written by the build with a content hash in its
# name (index-CRmkOZpE.js). A changed file gets a new name, so the old name can
# never go stale — which is exactly what `immutable` promises the browser.
# Without this Cloudflare sends `max-age=0, must-revalidate` and every repeat
# visitor re-checks the whole bundle before it can draw anything.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# public/imgs holds one file: schooling-fish.avif, the backdrop behind every
# page. It
# lives here rather than in src/ because index.html preloads it by name, and a
# name the build rewrites cannot be written into index.html by hand.
#
# A week, and no must-revalidate. This used to be an hour, which meant every
# repeat visitor spent a round trip re-checking the backdrop before the page
# could finish painting — for a file that changes about once a year. The
# backdrop is not hashed, so replacing it is a rename (a new filename) plus the
# matching edit to background.css and the preload in index.html; changing the
# bytes under the same name would leave the old copy in caches for a week.
#
# The logos are not here any more — they are imported through the bundler, get
# a content hash, and are covered by the immutable rule above.
/imgs/*
  Cache-Control: public, max-age=604800
